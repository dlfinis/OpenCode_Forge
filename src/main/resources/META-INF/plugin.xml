<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <id>io.github.dlfinis.opencode.forge</id>
  <name>OpenCode Forge</name>
  <!-- The vendor url is the publisher's landing page, shown as a link in the IDE plugin
       manager. No email on purpose: the descriptor ships inside the plugin archive and is
       published on the Marketplace page, so an address here is harvested by scrapers. The
       Marketplace account email is separate and private. -->
  <vendor url="https://github.com/dlfinis/OpenCode_Forge">Auropia</vendor>


  <description><![CDATA[
    <b>OpenCode Forge — the OpenCode AI coding agent, native to your JetBrains IDE.</b><br><br>

    No context switching, no copy-paste: connect to an OpenCode v2 server and drive
    an autonomous coding agent without leaving the IDE you already live in.<br><br>

    <b>⚡ Quick Launch</b><br>
    Press <code>Cmd+Esc</code> / <code>Ctrl+\</code> to launch an agent session in an integrated
    terminal — or attach to a running OpenCode Desktop server with automatic
    authentication. Connect first, code second.<br><br>

    <b>🧠 Context Sharing</b><br>
    Send the current file, your selection, or Project View items straight to the agent
    with <code>Opt+Cmd+K</code> / <code>Ctrl+Alt+K</code>. The agent sees exactly what you see —
    no re-explaining your codebase to a chat window.<br><br>

    <b>🔍 Native Diff Review</b><br>
    Every proposed change lands in a multi-file diff viewer. Accept stages it
    (<code>git add</code>), Reject restores the original content — and automatic snapshots
    guarantee you can always recover a previous version. Nothing touches your
    working tree unreviewed.<br><br>

    <b>🛡 OpenCode v2 native</b><br>
    Community fork of <a href="https://github.com/LaiZhou/OpenCode_UI">OpenCode UI</a> by LaiZhou,
    rebuilt against the OpenCode v2 server API. A v1 server is detected and reported
    as unsupported — no half-broken compatibility modes.<br><br>

    Compatible with IntelliJ IDEA, PyCharm, WebStorm, GoLand, Rider and other
    IntelliJ-based IDEs.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <!-- JCEF Browser Support (Optional) -->
  <depends optional="true" config-file="opencode-web-support.xml">com.intellij.modules.jcef</depends>

  <actions>
    <action id="OpenCode.QuickLaunch"
            class="ai.opencode.ide.jetbrains.QuickLaunchAction"
            text="Open OpenCode"
            description="Open or focus the OpenCode terminal"
            icon="/icons/opencode.svg">
      <add-to-group group-id="ToolsMenu" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control BACK_SLASH"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta ESCAPE"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta ESCAPE"/>
    </action>

    <action id="OpenCode.PreviousSession"
            class="ai.opencode.ide.jetbrains.actions.OpenPreviousSessionAction"
            text="Open Previous OpenCode Session"
            description="Resume one of this project's existing OpenCode sessions"
            icon="/icons/opencode.svg">
      <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="OpenCode.StopServer"/>
    </action>

    <action id="OpenCode.StopServer"
            class="ai.opencode.ide.jetbrains.actions.StopOpenCodeServerAction"
            text="Stop OpenCode Server"
            description="Stop the OpenCode server shared by IDE instances"
            icon="/icons/opencode.svg">
      <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="OpenCode.QuickLaunch"/>
    </action>

    <action id="OpenCode.AddLines"
            class="ai.opencode.ide.jetbrains.SendSelectionToTerminalAction"
            text="Add lines to OpenCode Terminal"
            icon="/icons/opencode.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="OpenCode.StopServer"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K"/>
    </action>

    <action id="OpenCode.AddFile"
            class="ai.opencode.ide.jetbrains.SendSelectionToTerminalAction"
            text="Add to OpenCode Terminal"
            icon="/icons/opencode.svg">
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K"/>
    </action>
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Project-level Services -->
    <projectService serviceImplementation="ai.opencode.ide.jetbrains.OpenCodeService"/>
    <projectService serviceImplementation="ai.opencode.ide.jetbrains.session.SessionManager"/>
    <projectService serviceImplementation="ai.opencode.ide.jetbrains.diff.DiffViewerService"/>

    <!-- File Editor Provider -->
    <fileEditorProvider implementation="ai.opencode.ide.jetbrains.terminal.OpenCodeTerminalFileEditorProvider"/>
    <!-- Web provider is registered only in opencode-web-support.xml (optional JCEF config-file);
         registering it here as well creates two JCEF browsers per web tab. -->

    <!-- Notifications -->
    <notificationGroup id="OpenCode" displayType="BALLOON"/>

    <toolWindow id="OpenCode"
                factoryClass="ai.opencode.ide.jetbrains.OpenCodeToolWindowFactory"
                icon="/icons/opencode.svg"
                anchor="right"/>

  </extensions>

  <projectListeners>
    <listener class="ai.opencode.ide.jetbrains.terminal.OpenCodeTerminalEditorListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>
</idea-plugin>
